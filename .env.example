# Server only. Do not use VITE_ prefixes for any of these values.
INDIAN_API_KEY=
# Choose the official host matching your plan: stock / dev / analyst / pro.
INDIAN_API_BASE_URL=https://stock.indianapi.in
GOOGLE_CLIENT_ID=
# Google Identity Services ID-token sign-in does not require a client secret.
# GOOGLE_CLIENT_SECRET is only needed if you later add an OAuth code flow.
SESSION_SECRET=replace-with-at-least-32-random-characters
APP_ORIGIN=http://localhost:5173
PORT=3001
DATABASE_PATH=./data/trovan.sqlite
NODE_ENV=development
# Set to the exact number of trusted reverse-proxy hops in production.
TRUST_PROXY=0
